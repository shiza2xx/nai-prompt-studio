{
  "name": "nai-prompt-studio",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Local Windows prompt studio for NovelAI artist workflows and image metadata.",
  "author": "shiza2xx",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/shiza2xx/nai-prompt-studio.git" },
  "homepage": "https://github.com/shiza2xx/nai-prompt-studio",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node tools/start-desktop-dev.mjs",
    "web:dev": "node tools/run-local.mjs node node_modules/vite/bin/vite.js",
    "desktop:dev": "node tools/start-desktop-dev.mjs",
    "build": "node tools/run-local.mjs node tools/prepare-icon.mjs && node tools/run-local.mjs node node_modules/typescript/bin/tsc --noEmit && node tools/run-local.mjs node node_modules/vite/bin/vite.js build",
    "desktop:build": "node tools/run-local.mjs node tools/build-desktop.mjs",
    "preview": "node tools/run-local.mjs node node_modules/vite/bin/vite.js preview",
    "catalog:update:v5": "node tools/run-local.mjs node tools/update-v5-catalog.mjs",
    "test": "node tools/run-local.mjs node --experimental-strip-types tools/tests.mjs",
    "installer:proof": "node tools/run-local.mjs node tools/installer-proof/build-and-run-proof.mjs",
    "import:guide-examples": "node tools/run-local.mjs node tools/import-hothottuk-guide.mjs",
    "release:manifest": "node tools/run-local.mjs node tools/generate-release-manifest.mjs",
    "release:catalog-packs": "node tools/run-local.mjs node tools/catalog-packs.mjs",
    "catalog:hydrate": "node tools/run-local.mjs node tools/hydrate-catalog.mjs"
  },
  "build": {
    "appId": "com.novelai.promptstudio",
    "productName": "NAI Prompt Studio",
    "directories": {
      "output": "release-v5"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "artifactName": "NAI-Prompt-Studio-V5-Payload-${version}.${ext}",
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "NAI Prompt Studio",
      "uninstallDisplayName": "NAI Prompt Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^40.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "allowScripts": {
    "electron@40.10.6": true,
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true
  }
}
